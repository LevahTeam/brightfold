{
  "name": "qt-passport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "serve": "next build && next start -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:export": "node scripts/export.mjs",
    "security:audit": "npm audit --audit-level=high",
    "dev:demo": "DEMO_MODE=1 QT_DB_PATH=./data/demo-run/qt.db next dev -p 3007",
    "serve:demo": "DEMO_MODE=1 QT_DB_PATH=./data/demo-run/qt.db next build && DEMO_MODE=1 QT_DB_PATH=./data/demo-run/qt.db next start -p 3007 -H 0.0.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
