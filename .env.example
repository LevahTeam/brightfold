# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------- required
# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this signs everyone out.
QTP_SESSION_SECRET=

# Signed-in sessions last seven days by default. Set a shorter value for
# shared devices; hosted deployments cap this at 30 days.
# QTP_SESSION_TTL_HOURS=168

# ---------------------------------------------------- photo extraction (optional)
# The app works without any of this — you can always fill the review table in
# by hand. Set a provider to turn on photo scanning.
#
# Options: gemini | openai-compatible | anthropic | none
VISION_PROVIDER=none

# --- Google Gemini (free tier, no card required) --------------------------
# Key: https://aistudio.google.com/apikey — sign in, "Create API key", done.
# The sheet photo is sent to Google for reading; nothing else is.
# VISION_PROVIDER=gemini
# GEMINI_API_KEY=
# VISION_MODEL=gemini-2.5-flash

# --- Groq (free tier, OpenAI-compatible) ----------------------------------
# Key: https://console.groq.com/keys
# VISION_PROVIDER=openai-compatible
# VISION_BASE_URL=https://api.groq.com/openai/v1
# VISION_API_KEY=
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- OpenRouter (has free vision models) ----------------------------------
# Key: https://openrouter.ai/keys
# VISION_PROVIDER=openai-compatible
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=
# VISION_MODEL=

# --- Anthropic (paid) ------------------------------------------------------
# VISION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5

# ------------------------------------------------------------------ storage
#
# Two ways to store the records, and the app picks whichever is configured.
#
# 1. HOSTED (Vercel). Set both of these and the app talks to Turso instead of
#    a local file. Required on Vercel: serverless functions get a throwaway
#    filesystem, so a file-backed database there loses every record silently.
#    Create one at https://turso.tech (free tier, no card):
#      turso db create qt-passport
#      turso db show qt-passport --url
#      turso db tokens create qt-passport
# TURSO_DATABASE_URL=libsql://qt-passport-you.turso.io
# TURSO_AUTH_TOKEN=

# Optional deployment guard for any non-Vercel host. Vercel enables the same
# protection automatically: the app refuses temporary local storage there.
# QTP_REQUIRE_HOSTED_DB=1

# 2. LOCAL FILE (default). Used whenever TURSO_DATABASE_URL is unset.
#    Where the SQLite file lives. Defaults to ./data/qt-passport.db
# QT_DB_PATH=

# Where `npm run db:backup` writes copies. Defaults to ./data/backups/
# Point this at a synced folder and every backup leaves this machine
# automatically — worth doing, because the live database is the only copy.
#   macOS Google Drive:  ~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/QT Passport
#   macOS iCloud Drive:  ~/Library/Mobile Documents/com~apple~CloudDocs/QT Passport
# QTP_BACKUP_DIR=

# ------------------------------------------------------- seeding (optional)
# If unset, `npm run db:seed` generates and prints a random password once.
# QTP_SEED_VOLUNTEER_PW=
# QTP_SEED_PASTOR_PW=
